{
  "name": "@classroom/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@classroom/shared": "*",
    "dotenv": "^17.2.3",
    "exceljs": "4.4.0",
    "express": "^5.1.0",
    "jszip": "3.10.2",
    "socket.io": "^4.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.9.2",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.20.6",
    "vitest": "^4.1.12"
  }
}
