# 複製成 .env 後填入；.env 不會進版本控制
TEACHER_PASSWORD=
PORT=3000
DATA_DIR=./data

# ---------------------------------------------------------------------------
# 部署（詳細說明見 docs/deployment.md）
# ---------------------------------------------------------------------------

# 綁定位址。預設是「所有介面」（教室內用需要，學生才連得到）。
# 只有在「伺服器跑在主機上、前面有反向代理」時才設成 127.0.0.1。
HOST=

# 同時在線的 Socket.IO 連線數上限。超過時新連線被拒（403），
# 已連線的不受影響，客戶端會自動退避重連。0 = 不限制。
MAX_CONNECTIONS=500

# 進場（/api/student/join）的速率限制：
#   JOIN_RATE_LIMIT_BURST      同一來源可「瞬間」進場的次數
#                              （必須容得下整班學生同時進場；50 組班級約 200 人）
#   JOIN_RATE_LIMIT_PER_MINUTE 同一來源「持續」進場的速率（灌水會被壓到這個速率）
# 任一個設為 0 即整個限流不啟用（壓測工具兩個都設 0）。
JOIN_RATE_LIMIT_BURST=600
JOIN_RATE_LIMIT_PER_MINUTE=30

# ---------------------------------------------------------------------------
# 006：寫回線上 Google 試算表（服務帳號共用）
# 沒有這兩項時「寫回 Google 試算表」會回 SHEET_NOT_CONFIGURED，
# 其餘功能（匯出 xlsx／CSV、匯入）都照常可用。
#
# 建立步驟（老師做一次即可）：
#   1. https://console.cloud.google.com/ → 建立專案
#   2. APIs & Services → Library → 搜尋「Google Sheets API」→ Enable
#   3. IAM & Admin → Service Accounts → Create service account
#      （角色可以留空；對試算表的權限來自「把試算表共用給服務帳號信箱」）
#   4. 服務帳號 → Keys → Add key → Create new key → JSON
#   5. 把 JSON 裡的 client_email 填到下面，private_key 貼成單行、換行寫成 \n
#   6. 把試算表「共用」給這個信箱，權限選「編輯者」
#      （只開「知道連結者可檢視」不足以寫入）
#
# 金鑰只留在這台電腦的 .env，不要貼到群組訊息、issue 或版本控制。
# ---------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
